# Data.gov.in API key for secondary Agmarknet mandi data fallback
# Get a free key at https://data.gov.in/
DATA_GOV_API_KEY=

# Maximum age of Agmarknet last-week observations before they are flagged stale (days)
AGMARKNET_MAX_AGE_DAYS=7

# Road distance and routing configuration (OSRM)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_ALLOW_PUBLIC_DEMO=true

# Frontend configuration (React / Vite)
# Leave empty for Vite dev server proxy to handle requests at same-origin,
# or set to http://127.0.0.1:8000 for direct cross-origin API calls.
VITE_API_BASE_URL=

# Backend target URL used by the Vite dev/preview proxy (defaults to http://127.0.0.1:8000)
VITE_BACKEND_URL=http://127.0.0.1:8000
