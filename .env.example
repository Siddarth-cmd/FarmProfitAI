# =============================================================================
# FarmProfit AI - Environment Configuration
# =============================================================================

# Data.gov.in Open Government Data (OGD) API key for Agmarknet mandi market data
# How to get a free key:
# 1. Register for an account at https://data.gov.in/
# 2. Go to My Account -> API Key to copy your unique API key
# 3. Paste your key below (or leave blank to use direct Agmarknet queries and local cache):
DATA_GOV_API_KEY=

# Freshness thresholds for market observations (in days)
# Observations <= FRESHNESS_HIGH_DAYS are flagged 'fresh' (High Confidence)
# Observations <= AGMARKNET_MAX_AGE_DAYS are flagged 'within_acceptable_window'
FRESHNESS_HIGH_DAYS=3
AGMARKNET_MAX_AGE_DAYS=7

# Road distance and routing configuration (OSRM)
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_ALLOW_PUBLIC_DEMO=true

# Frontend configuration (React / Vite)
# Leave empty for Vite dev server proxy to handle requests at same-origin,
# or set to http://127.0.0.1:8000 for direct cross-origin API calls.
VITE_API_BASE_URL=

# Backend target URL used by the Vite dev/preview proxy (defaults to http://127.0.0.1:8000)
VITE_BACKEND_URL=http://127.0.0.1:8000
